# Biggest confusion in Data Types:
# Mutable vs Immutable Data Types

# IMMUTABLE DATA TYPE (int)
x = 10
y = x

print("Before changing x:")
print("x =", x)
print("y =", y)

x = 20

print("\nAfter changing x:")
print("x =", x)
print("y =", y)


# MUTABLE DATA TYPE (list)
a = [1, 2, 3]
b = a

print("\nBefore changing list:")
print("a =", a)
print("b =", b)

b.append(4)

print("\nAfter changing list:")
print("a =", a)
print("b =", b)


# Checking memory location
print("\nMemory Address:")
print("id(a) =", id(a))
print("id(b) =", id(b))

# Biggest Data Type Problem:
# Type Conversion and Type Errors

# Integer
age = 20

# String
marks = "95"

# Float
height = 5.9

# Boolean
is_student = True

print("Original Data Types:")
print(type(age))
print(type(marks))
print(type(height))
print(type(is_student))


# Type Conversion
converted_marks = int(marks)

total = age + converted_marks

print("\nAfter Type Conversion:")
print("Converted Marks =", converted_marks)
print("Total =", total)


# Common Beginner Mistake
num1 = "10"
num2 = "20"

print("\nWithout Conversion:")
print(num1 + num2)   # String concatenation


# Correct Way
print("\nWith Conversion:")
print(int(num1) + int(num2))


